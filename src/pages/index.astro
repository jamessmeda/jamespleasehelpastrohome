---
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Feedback Images
import {Image} from "astro:assets";
import  feedbackImage1  from '../images/feedback/2024-03-13_13-55-03.png';
import  feedbackImage2  from '../images/feedback/2024-03-13_13-56-01.png';

// Component Imports
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hello, my name is James."
					tagline="I am an admin who is currently based in South Australia."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> Developer</Pill>
						<Pill><Icon icon="microphone-stage" size="1.33em" /> Speaker</Pill>
						<Pill><Icon icon="pencil-line" size="1.33em" /> Writer</Pill>
						<Pill><Icon icon="chalkboard-teacher" size="1.33em" /> Teacher</Pill>
					</div>
				</Hero>

				<img
					alt="James smiling in a grey top with sun glasses"
					width="480"
					height="620"
					src="/assets/portrait.jpg"
				/>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>What I do</h3>
					<p>I use experience, patience and practical thinking to help people understand technology and solve problems.</p>
				</header>

				<div class="gallery">
					<Grid variant="small">
						<li class="overview-card">
							<Icon icon="terminal-window" size="2rem" />
							<h4>Technology</h4>
							<p>I support systems, develop practical solutions and make technical ideas easier to understand.</p>
						</li>
						<li class="overview-card">
							<Icon icon="chalkboard-teacher" size="2rem" />
							<h4>Training</h4>
							<p>I create and deliver approachable training that helps people learn at their own pace.</p>
						</li>
						<li class="overview-card">
							<Icon icon="strategy" size="2rem" />
							<h4>Mentoring</h4>
							<p>I enjoy sharing experience, encouraging others and helping people grow in confidence.</p>
						</li>
					</Grid>
				</div>
			</section>

			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Feedback from friends and family</h3>
					<p>
						I have been fortunate enough to receive kind words from people in my life. Mostly they think I'm ok.
					</p>
				</header>

				<div class="gallery">
					<Grid variant="small">
						{
							['Mick', 'Manfred', 'Marvin', 'Chrissie', 'Stephen'].map((brand) => (
								<li class="mention-card">
									<p>{brand}</p>
								</li>
							))
						}
					</Grid>
				</div>





			</section>
			<section aria-label="Feedback screenshots">
				<div class="gallery">
					<Grid>
						<li class="feedback-card">
							<Image src={feedbackImage1} alt="Written feedback about James" />
						</li>
						<li class="feedback-card">
							<Image src={feedbackImage2} alt="Additional written feedback about James" />
						</li>
					</Grid>
				</div>

			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.overview-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-height: 14rem;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.overview-card :global(svg) {
		color: var(--accent-regular);
	}

	.overview-card h4 {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.feedback-card {
		overflow: hidden;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.feedback-card :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
