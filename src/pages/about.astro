---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';

import { Image } from 'astro:assets';
import localMentorImage from '../images/mentor.jpg';
import localLectureImage from '../images/systemadmin.jpg';
import localMusicImage from '../images/a.jpg';
---

<BaseLayout title="About | James Smeda" description="Learn about James Smeda's background in system administration, mentoring and music.">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. I was helping people when Blackberry was something you typed on."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="James Smeda on a business trip."
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						Somewhere between starting out as a Turbo Pascal programmer and administering systems for 30 years, I found that helping people is what matters most to me.
						This seems to be my WHY in life. I have been a part of the IT industry for over 30 years and have seen the industry change and grow.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Mentoring</h2>
				<div class="content">
					<p>
						I would never have been able to get to where I am today without the help of others. I have been fortunate to have had some great mentors in my life.
						Now I am in a position to give back and help others. I have been mentoring people for over 10 years and have seen some great success stories.
					</p>
					<Image src={localMentorImage} alt="James helping and teaching others."/>
				</div>
			</section>
			<section>
				<h2 class="section-title">System Administration</h2>
				<div class="content">
					<p>
						I'm in the process of writing "Time Management in Your New Role" and "The Art of Being Hubabkuk".
						I have been a system administrator for over 30 years and have seen the industry change and grow.
						
					</p>
					<Image src={localLectureImage} alt="James lecturing."/>
				</div>
			</section>
			<section>
				<h2 class="section-title">Music</h2>
				<div class="content">
					<p>
						I come from a musical family where we sing and enjoy music.
						Please visit my music page to see what I have been up to.


					</p>
					<p>Read more <a href="https://jamessmeda.bandcamp.com">https://jamessmeda.bandcamp.com</a></p>
					<Image src={localMusicImage} alt="James performing music."/>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
