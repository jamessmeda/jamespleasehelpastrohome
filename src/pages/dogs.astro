---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

import dogCurious from '../images/dogs/dog-curious-cutout.png';
import dogOnGrass from '../images/dogs/dog-on-grass-cutout.png';
import dogLookingOut from '../images/dogs/dog-looking-out-cutout.png';
import dogAtHome from '../images/dogs/dog-at-home-cutout.png';
import dogByWindow from '../images/dogs/dog-by-window-cutout.png';
import dogResting from '../images/dogs/dog-resting-cutout.png';

const photos = [
	{ src: dogOnGrass, alt: 'A small black dog sitting on the grass wearing a red collar.', className: 'portrait' },
	{ src: dogLookingOut, alt: 'A small black dog sitting on the grass and looking attentively to the side.', className: 'portrait' },
	{ src: dogAtHome, alt: 'A black dog with a white chest sitting inside by a glass door.', className: 'wide' },
	{ src: dogByWindow, alt: 'A small black dog standing in the sunlight beside a window.', className: 'portrait' },
	{ src: dogResting, alt: 'A close-up of a black dog resting its head on an orange cushion.', className: 'portrait' },
];
---

<BaseLayout
	title="My Dog | James Smeda"
	description="Meet James Smeda's much-loved 12-year-old dog through a collection of favourite photos."
>
	<main class="wrapper dogs-page stack gap-15">
		<Hero
			title="My Dog"
			tagline="A few favourite photos of a much-loved member of my family."
		>
			<div class="hero-photo">
				<Image
					src={dogCurious}
					alt="A curious black dog with a white chest looking up at the camera."
					widths={[640, 960, 1200]}
					sizes="(min-width: 50rem) 60rem, 100vw"
					loading="eager"
				/>
			</div>
		</Hero>

		<section class="intro" aria-labelledby="dogs-intro">
			<p class="eyebrow">Good company</p>
			<h2 id="dogs-intro">Life is better with dogs</h2>
			<p>
				He is 12 years old and very much part of the family. He brings companionship, personality and plenty of memorable moments to everyday life.
			</p>
		</section>

		<section class="gallery-section" aria-labelledby="photo-gallery">
			<div class="gallery-heading">
				<h2 id="photo-gallery">Photo gallery</h2>
				<p>Quiet moments, curious looks and days spent together.</p>
			</div>

			<div class="gallery">
				{
					photos.map((photo) => (
						<figure class:list={['photo', photo.className]}>
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[480, 720, 960]}
								sizes="(min-width: 64rem) 32rem, (min-width: 42rem) 50vw, 100vw"
								loading="lazy"
							/>
						</figure>
					))
				}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.dogs-page {
		padding-bottom: 6rem;
	}

	.hero-photo {
		max-width: 62rem;
		margin: 1.5rem auto 0;
		overflow: hidden;
		border: 1px solid var(--gray-800);
		border-radius: 1.75rem;
		background:
			radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--brand-ivory) 80%, transparent), transparent 42%),
			linear-gradient(145deg, var(--brand-sage), color-mix(in srgb, var(--brand-sage) 55%, var(--brand-ivory)));
		box-shadow: var(--shadow-lg);
	}

	.hero-photo :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		padding: clamp(1rem, 4vw, 2.5rem) clamp(1rem, 6vw, 4rem) 0;
		object-fit: contain;
		filter: drop-shadow(0 1.25rem 1rem rgba(38, 50, 56, 0.2));
	}

	.intro {
		max-width: 44rem;
		margin-inline: auto;
		padding: clamp(1.5rem, 5vw, 3rem);
		border-left: 0.4rem solid var(--brand-clay);
		border-radius: 0 1.25rem 1.25rem 0;
		background: color-mix(in srgb, var(--brand-sage) 38%, var(--gray-999));
	}

	.intro h2,
	.gallery-heading h2 {
		font-size: var(--text-2xl);
		color: var(--gray-0);
	}

	.intro > p:last-child,
	.gallery-heading p {
		margin-top: 0.75rem;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.eyebrow {
		margin-bottom: 0.4rem;
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-clay);
	}

	.gallery-section {
		display: grid;
		gap: 1.5rem;
	}

	.gallery-heading {
		max-width: 44rem;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-flow: dense;
		gap: 0.8rem;
	}

	.photo {
		overflow: hidden;
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		background: linear-gradient(145deg, var(--brand-sage), color-mix(in srgb, var(--brand-sage) 60%, var(--brand-ivory)));
		box-shadow: var(--shadow-sm);
	}

	.photo:nth-child(3n + 2) {
		background: linear-gradient(145deg, color-mix(in srgb, var(--brand-clay) 28%, var(--brand-ivory)), var(--brand-ivory));
	}

	.photo:nth-child(3n) {
		background: linear-gradient(145deg, color-mix(in srgb, var(--brand-teal) 82%, var(--brand-sage)), var(--brand-teal));
	}

	.photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		padding: 1rem 1rem 0;
		object-fit: contain;
		filter: drop-shadow(0 0.9rem 0.7rem rgba(38, 50, 56, 0.2));
	}

	.photo.portrait {
		aspect-ratio: 3 / 4;
	}

	.photo.wide {
		grid-column: 1 / -1;
		aspect-ratio: 4 / 3;
	}

	@media (min-width: 42em) {
		.gallery {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.photo.portrait {
			grid-column: span 2;
		}

		.photo.wide {
			grid-column: span 4;
			aspect-ratio: 16 / 9;
		}
	}

	@media (min-width: 64em) {
		.gallery {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.photo.portrait {
			grid-column: span 2;
		}

		.photo.wide {
			grid-column: span 4;
			grid-row: span 2;
			aspect-ratio: auto;
		}
	}
</style>
